{
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_SHELL": "/usr/bin/bash"
  },
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(/tmp/*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(chmod *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(nvim --headless *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(tree *)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(systemctl status *)",
      "Bash(apt list *)",
      "Bash(curl localhost*)",
      "Bash(curl http://localhost*)",
      "Read(~/.claude/CLAUDE.md)",
      "Read(/tmp/*)",
      "Edit(/tmp/*)",
      "Write(/tmp/*)"
    ]
  },
  "model": "opus",
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    }
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
